{
  "name": "snake-game",
  "version": "1.0.0",
  "description": "Змейка с бустами, комбо и магазином скинов",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.yourname.snakegame",
    "productName": "Змейка",
    "files": [
      "main.js",
      "preload.js",
      "game/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
