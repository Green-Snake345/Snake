modules = ["python-3.11", "nodejs-24"]
[nix]
channel = "stable-25_05"
packages = ["unzip", "yakut"]

run = "bash run_forever.sh"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[deployment]
deploymentTarget = "cloudrun"

[deployment.run]
args = ["sh", "-c", "python3 main.py"]

[deployment.run.env]
PORT = "3000"
HOST = "0.0.0.0"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 python3 main.py"
waitForPort = 5000
