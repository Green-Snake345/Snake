{
  "name": "snake-game",
  "version": "1.0.0",
  "description": "Классическая Змейка: монеты, магазин скинов, комбо, бусты, уровни и ежедневные задания. Играй в браузере на пк и на телефоне",
  "main": "main.js",
  "homepage": "https://github.com/Green-Snake345/Snake",
  "author": "Green-Snake345",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:linux": "electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.2.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.greensnake.snake",
    "productName": "Змейка",
    "copyright": "Copyright © 2026 Змейка",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "**/*.css",
      "**/*.js",
      "build/**/*"
    ],
    "win": {
      "target": ["nsis", "zip"],
      "icon": "build/icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb", "pacman", "tar.gz", "snap", "rpm"],
      "category": "Game",
      "icon": "build/icon.png",
      "executableName": "snake",
      "maintainer": "Green-Snake345 <AleshaLevin777@yandex.ru>"
    },
    "deb": {
      "depends": [
        "libasound2t64",
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "at-spi2-atk",
        "libnotify",
        "libxss",
        "libxtst",
        "xdg-utils",
        "libsecret"
      ]
    },
    "rpm": {
      "depends": [
        "alsa-lib",
        "gtk3",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "libsecret"
      ]
    },
    "snap": {
      "confinement": "strict",
      "grade": "stable",
      "plugs": [
        "home",
        "network",
        "audio-playback",
        "desktop",
        "desktop-legacy",
        "wayland",
        "x11"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "Green-Snake345",
      "repo": "Snake"
    }
  }
}
